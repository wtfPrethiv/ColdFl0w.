<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.coldflow.agent</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/coldflow</string>
    <string>--data</string><string>/Users/YOUR_USER/Library/Application Support/coldflow</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/Library/Logs/coldflow.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/Library/Logs/coldflow-error.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>GOMEMLIMIT</key><string>350MiB</string>
    <key>GOMAXPROCS</key><string>1</string>
    <!-- Add your provider environment variables locally; do not commit them. -->
  </dict>
</dict></plist>
